# EditorConfig: https://editorconfig.org

root = true

# All files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python files
[*.py]
indent_size = 4

# Markdown files (keep trailing whitespace)
[*.md]
trim_trailing_whitespace = false

# YAML / JSON files
[*.{yml,yaml,json}]
indent_size = 2
